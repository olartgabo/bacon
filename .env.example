# SQLite file that holds every task. On the host this lives on a persistent
# volume (/data/bacon.sqlite); locally it defaults to ./bacon.sqlite.
DATABASE_PATH=

# Local checkout of olartgabo/olympus. The home page reads its Markdown, and
# the export job writes task snapshots into tasks/bacon/ and pushes them.
OLYMPUS_REPO_PATH=

# Cloudflare Access, which fronts the web UI. The app verifies the
# Cf-Access-Jwt-Assertion header against the team's signing keys, so both
# values are required in production. CF_ACCESS_AUD is the Application
# Audience (AUD) tag from the Access application's overview page.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# The email that becomes the owner identity on first sign-in.
BACON_OWNER_EMAIL=

# Local development only: act as this email without Cloudflare Access.
# Ignored when NODE_ENV is production.
BACON_DEV_EMAIL=
