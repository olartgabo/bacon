# Path to a local checkout of olartgabo/olympus that this dashboard reads
# Markdown from. On the Lightsail host this is a server-side git clone kept
# up to date by a scheduled pull (see docs/web-dashboard-stack.md build order
# stage 2+); in local dev, point it at your existing olympus checkout.
OLYMPUS_REPO_PATH=

# Only needed by scripts/capture.mjs and scripts/sync-captures.mjs when
# calling the deployed origin (tasks.olartgabo.dev) instead of localhost —
# a Cloudflare Access service token so non-browser callers can reach the
# write API through the same Access application that fronts the browser UI.
# See tasks/0007-dashboard-task-capture.md in olympus.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
